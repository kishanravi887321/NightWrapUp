PORT=5000
MONGO_DB_URL=mongodb://127.0.0.1:27017/night-wrap-up
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_EXTENSION_SECRET=replace-with-a-third-long-random-extension-secret
JWT_ACCESS_EXPIRES_IN=15d
JWT_REFRESH_EXPIRES_IN=30d
JWT_EXTENSION_EXPIRES_IN=365d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://nightwrapup.ziax.online
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Production uses .ziax.online so auth cookies are shared by the frontend and API subdomains.
# Local development leaves this unset.
